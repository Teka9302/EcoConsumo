<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- HU0003: notificaciones de productos próximos a vencer -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Requerido por ApiService (Retrofit) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".EcoConsumoApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.EcoConsumo">

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.EcoConsumo.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.RegistroActivity"
            android:label="@string/titulo_registro"
            android:parentActivityName=".ui.auth.LoginActivity" />

        <activity android:name=".MainActivity" />

        <activity
            android:name=".ui.despensa.ProductoFormActivity"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.despensa.DetalleProductoActivity"
            android:label="@string/titulo_detalle"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.estadisticas.HistorialActivity"
            android:label="@string/titulo_historial"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.cuenta.HogarActivity"
            android:label="@string/titulo_hogar"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.cuenta.PerfilActivity"
            android:label="@string/titulo_perfil"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.cuenta.AjustesActivity"
            android:label="@string/titulo_ajustes"
            android:parentActivityName=".MainActivity" />
    </application>

</manifest>
