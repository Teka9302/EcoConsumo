<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.EcoConsumo" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/verde_primario</item>
        <item name="colorPrimaryContainer">@color/verde_claro</item>
        <item name="colorOnPrimary">@color/blanco</item>
        <item name="colorSecondary">@color/verde_oscuro</item>
        <item name="android:statusBarColor">@color/verde_oscuro</item>
        <!-- En Android 15 evita que la barra de título y las barras del sistema tapen el contenido -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <style name="Theme.EcoConsumo.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
